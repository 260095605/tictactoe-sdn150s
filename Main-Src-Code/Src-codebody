    private static Image loadImageSafe(String fileName) {
        String[] paths = {
            fileName,
            "C:\\TicTacToe\\" + fileName,
            "C:\\Java Project Files\\" + fileName,
            System.getProperty("user.dir") + File.separator + fileName
        };

        for (String p : paths) {
            File f = new File(p);
            if (f.exists()) {
                return new ImageIcon(f.getAbsolutePath()).getImage();
            }
        }
        
        try {
            java.net.URL url = TicTacToe.class.getResource("/" + fileName);
            if (url != null) {
                return new ImageIcon(url).getImage();
            }
        } catch (Exception e) {}

        return null;
    }

