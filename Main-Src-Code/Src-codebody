    private void handleCell(int r, int c) {
        if (!gameActive || !boardState[r][c].equals("")) return;
        executeMove(r, c, isXTurn ? "X" : "O");
        if (!gameActive) return;

        if (vsAiMode && gameActive && !isXTurn) {
            Timer t = new Timer(350, e -> {
                if (!gameActive) return;
                int[] m = null;
                if (aiDifficulty == 1) {
                    m = getRandomMove();
                } else if (aiDifficulty == 2) {
                    m = getMediumMove();
                } else {
                    m = getMinimaxMove();
                }
                if (m != null) executeMove(m[0], m[1], "O");
            });
            t.setRepeats(false);
            t.start();
        }
    }

    private void executeMove(int r, int c, String p) {
        boardState[r][c] = p;
        JButton btn = boardButtons[r][c];
        int w = btn.getWidth();
        int h = btn.getHeight();

        if (p.equals("X")) {
            if (rawXImage != null) btn.setIcon(scaleImg(rawXImage, w, h));
            else btn.setText("X");
            statusLabel.setText("Player O's Turn");
        } else {
            if (rawOImage != null) btn.setIcon(scaleImg(rawOImage, w, h));
            else btn.setText("O");
            statusLabel.setText("Player X's Turn");
        }

        checkState();
        isXTurn = !isXTurn;
    }

    private int[] getRandomMove() {
        java.util.List<int[]> lst = new java.util.ArrayList<>();
        for (int r = 0; r < 3; r++) {
            for (int c = 0; c < 3; c++) {
                if (boardState[r][c].equals("")) lst.add(new int[]{r, c});
            }
        }
        if (lst.isEmpty()) return null;
        return lst.get(new java.util.Random().nextInt(lst.size()));
    }

    private int[] getMediumMove() {
        int[] m = findSmart();
        if (m != null) return m;
        return getRandomMove();
    }

    private int[] getMinimaxMove() {
        int best = Integer.MIN_VALUE;
        int[] move = null;
        for (int r = 0; r < 3; r++) {
            for (int c = 0; c < 3; c++) {
                if (boardState[r][c].equals("")) {
                    boardState[r][c] = "O";
                    int score = minimaxAlgo(boardState, 0, false);
                    boardState[r][c] = "";
                    if (score > best) {
                        best = score;
                        move = new int[]{r, c};
                    }
                }
            }
        }
        return move;
    }

    private int minimaxAlgo(String[][] b, int depth, boolean isMax) {
        if (checkWinStatic(b, "O")) return 10 - depth;
        if (checkWinStatic(b, "X")) return depth - 10;
        if (isFullStatic(b)) return 0;

        if (isMax) {
            int max = Integer.MIN_VALUE;
            for (int r = 0; r < 3; r++) {
                for (int c = 0; c < 3; c++) {
                    if (b[r][c].equals("")) {
                        b[r][c] = "O";
                        max = Math.max(max, minimaxAlgo(b, depth + 1, false));
                        b[r][c] = "";
                    }
                }
            }
            return max;
        } else {
            int min = Integer.MAX_VALUE;
            for (int r = 0; r < 3; r++) {
                for (int c = 0; c < 3; c++) {
                    if (b[r][c].equals("")) {
                        b[r][c] = "X";
                        min = Math.min(min, minimaxAlgo(b, depth + 1, true));
                        b[r][c] = "";
                    }
                }
            }
            return min;
        }
    }

    private int[] findSmart() {
        for (int r = 0; r < 3; r++) {
            for (int c = 0; c < 3; c++) {
                if (boardState[r][c].equals("")) {
                    boardState[r][c] = "O";
                    if (checkWin("O")) { boardState[r][c] = ""; return new int[]{r, c}; }
                    boardState[r][c] = "";
                }
            }
        }
        for (int r = 0; r < 3; r++) {
            for (int c = 0; c < 3; c++) {
                if (boardState[r][c].equals("")) {
                    boardState[r][c] = "X";
                    if (checkWin("X")) { boardState[r][c] = ""; return new int[]{r, c}; }
                    boardState[r][c] = "";
                }
            }
        }
        return null;
    }

    private boolean checkWin(String p) {
        return checkWinStatic(boardState, p);
    }

    private boolean checkWinStatic(String[][] b, String p) {
        for (int i = 0; i < 3; i++) {
            if (b[i][0].equals(p) && b[i][1].equals(p) && b[i][2].equals(p)) return true;
            if (b[0][i].equals(p) && b[1][i].equals(p) && b[2][i].equals(p)) return true;
        }
        if (b[0][0].equals(p) && b[1][1].equals(p) && b[2][2].equals(p)) return true;
        if (b[0][2].equals(p) && b[1][1].equals(p) && b[2][0].equals(p)) return true;
        return false;
    }

    private boolean isFullStatic(String[][] b) {
        for (int r = 0; r < 3; r++) {
            for (int c = 0; c < 3; c++) {
                if (b[r][c].equals("")) return false;
            }
        }
        return true;
    }

    private void checkState() {
        for (int i = 0; i < 3; i++) {
            if (!boardState[i][0].equals("") && boardState[i][0].equals(boardState[i][1]) && boardState[i][1].equals(boardState[i][2])) {
                endGame(boardState[i][0]);
                return;
            }
            if (!boardState[0][i].equals("") && boardState[0][i].equals(boardState[1][i]) && boardState[1][i].equals(boardState[2][i])) {
                endGame(boardState[0][i]);
                return;
            }
        }

        if (!boardState[0][0].equals("") && boardState[0][0].equals(boardState[1][1]) && boardState[1][1].equals(boardState[2][2])) {
            endGame(boardState[0][0]);
            return;
        }
        if (!boardState[0][2].equals("") && boardState[0][2].equals(boardState[1][1]) && boardState[1][1].equals(boardState[2][0])) {
            endGame(boardState[0][2]);
            return;
        }

        if (isFullStatic(boardState)) {
            draws++;
            statusLabel.setText("It's a Draw!");
            scoreLabel.setText("X Wins: " + xWins + " | O Wins: " + oWins + " | Draws: " + draws);
            gameActive = false;
        }
    }

    private void endGame(String winner) {
        if (winner.equals("X")) {
            xWins++;
            statusLabel.setText("Player X Wins!");
        } else {
            oWins++;
            statusLabel.setText("Player O Wins!");
        }
        scoreLabel.setText("X Wins: " + xWins + " | O Wins: " + oWins + " | Draws: " + draws);
        gameActive = false;
    }

    private void resetBoard() {
        for (int r = 0; r < 3; r++) {
            for (int c = 0; c < 3; c++) {
                boardState[r][c] = "";
                boardButtons[r][c].setIcon(null);
                boardButtons[r][c].setText("");
            }
        }
        isXTurn = true;
        gameActive = true;
        statusLabel.setText("Player X's Turn");
    }

    private Image removeBackground(Image img) {
        ImageIcon icn = new ImageIcon(img);
        int w = icn.getIconWidth();
        int h = icn.getIconHeight();
        if (w <= 0 || h <= 0) { w = 150; h = 150; }
        BufferedImage bi = new BufferedImage(w, h, BufferedImage.TYPE_INT_ARGB);
        Graphics2D g2 = bi.createGraphics();
        g2.drawImage(img, 0, 0, w, h, null);
        g2.dispose();
        
        for (int y = 0; y < h; y++) {
            for (int x = 0; x < w; x++) {
                int rgb = bi.getRGB(x, y);
                Color clr = new Color(rgb);
                int r = clr.getRed();
                int g = clr.getGreen();
                int b = clr.getBlue();

                if ((r > 210 && g > 210 && b > 210) || (Math.abs(r - g) < 15 && Math.abs(g - b) < 15 && r > 160)) {
                    bi.setRGB(x, y, 0x00000000);
                }
            }}
        }
        return bi;
    }

    private ImageIcon scaleImg(Image img, int bw, int bh) {
        if (img == null) return null;
        int sz = Math.min(bw, bh) - 4;
        if (sz < 30) sz = 90;
        return new ImageIcon(img.getScaledInstance(sz, sz, Image.SCALE_SMOOTH));
    }

    private static void playSplash() {
        try {
            Image fImg = loadImageSafe("splash_1.jpg");
            if (fImg != null) {
                JWindow win = new JWindow();
                JPanel pnl = new JPanel(new BorderLayout());
                ImageIcon icn = new ImageIcon(fImg);
                JLabel lbl = new JLabel(icn);
                pnl.add(lbl, BorderLayout.CENTER);
                win.add(pnl);
                win.pack();
                win.setLocationRelativeTo(null);
                win.setVisible(true);

                String[] frames = {"splash_1.jpg", "splash_2.jpg", "splash_3.jpg", "splash_4.jpg"};
                for (String name : frames) {
                    Image im = loadImageSafe(name);
                    if (im != null) {
                        icn.setImage(im);
                        lbl.repaint();
                    }
                    Thread.sleep(400);
                }
                Thread.sleep(600);
                win.dispose();
            }
        } catch (Exception e) {}
    }

