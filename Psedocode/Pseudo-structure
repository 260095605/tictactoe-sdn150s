Return true 
        End For 
        // Check diagonals 
        If board[0][0] == symbol and board[1][1] == symbol and board[2][2] == symbol Then 
Return true 
        If board[0][2] == symbol and board[1][1] == symbol and board[2][0] == symbol Then 
Return true 
         
        Return false 
    End Function 
 
    Function isBoardCompletelyFull(board) 
        For r = 0 to 2 
            For c = 0 to 2 
                If board[r][c] == "" Then Return false 
        Return true 
    End Function 
 
    Function evaluateGameStatus() 
        If checkWinCondition(stateGrid, "X") Then 
            winsX++ 
            infoLabel.setText("Player X Wins!") 
            updateScoreTextDisplay() 
            isGameRunning = false 
        Else If checkWinCondition(stateGrid, "O") Then 
            winsO++ 
            infoLabel.setText("Player O Wins!") 
            updateScoreTextDisplay() 
            isGameRunning = false 
        Else If isBoardCompletelyFull(stateGrid) Then 
            ties++ 
            infoLabel.setText("It's a Draw!") 
            updateScoreTextDisplay() 
            isGameRunning = false 
        End If 
    End Function 
 
