     Function getRandomMove()
     List emptyCells = [] 
     For r = 0 to 2
     For c = 0 to 2
     If stateGrid [r][c] == ""Then emptyCells.add([r,c])
     If emptyCells.isEmpty()Then Return null
     Return random elements from emptyCells
     End Function

     Function getMediumMove()
//1.Can AI win in one move? Do it.
//2.Can player win in next move? Block them.
//Otherwise pick random

    Integer[]smartSpot = findImmediateWinOrBlock()
    If smartSpot is not null Then Return smartSpot
    Return getRandoMove()
    End Fuction
 Function findImmediateWinOrBlock() 
        // Check AI winning move ("O") 
        For r = 0 to 2 
            For c = 0 to 2 
                If stateGrid[r][c] == "" Then 
                    stateGrid[r][c] = "O" 
                    If checkWinCondition(stateGrid, "O") Then  
                        stateGrid[r][c] = "" 
                        Return [r, c] 
                    End If 
                    stateGrid[r][c] = "" 
                End If 
        End For 
         
        // Check player blocking move ("X") 
        For r = 0 to 2 
            For c = 0 to 2 
                If stateGrid[r][c] == "" Then 
                    stateGrid[r][c] = "X" 
                    If checkWinCondition(stateGrid, "X") Then  
                        stateGrid[r][c] = "" 
                        Return [r, c] 
                    End If 
                    stateGrid[r][c] = "" 
                End If 
        End For 
         
        Return null 
    End Function 
 
    Function getMinimaxBestMove() 
        Integer bestScore = -99999 
        Integer[] bestMove = null 
         
        For r = 0 to 2 
            For c = 0 to 2 
                If stateGrid[r][c] == "" Then 
                    stateGrid[r][c] = "O" 
                    Integer score = minimaxRecursive(stateGrid, 0, false) 
                    stateGrid[r][c] = "" 
                     
                    If score > bestScore Then 
                        bestScore = score 
                        bestMove = [r, c] 
                    End If 
                End If 
        End For 
        Return bestMove 
    End Function 
 
    Function minimaxRecursive(boardCopy, depth, isMaximizing) 
        If checkWinCondition(boardCopy, "O") Then Return 10 - depth 
        If checkWinCondition(boardCopy, "X") Then Return depth - 10 
        If isBoardCompletelyFull(boardCopy) Then Return 0 
 
        If isMaximizing Then 
            Integer maxEval = -99999 
            For r = 0 to 2 
                For c = 0 to 2 
                    If boardCopy[r][c] == "" Then 
                        boardCopy[r][c] = "O" 
                        Integer eval = minimaxRecursive(boardCopy, depth + 1, false) 
                        boardCopy[r][c] = "" 
                        maxEval = Max(maxEval, eval) 
                    End If 
            End For 
            Return maxEval 
        Else 
            Integer minEval = 99999 
            For r = 0 to 2 
                For c = 0 to 2 
                    If boardCopy[r][c] == "" Then 
                        boardCopy[r][c] = "X" 
                        Integer eval = minimaxRecursive(boardCopy, depth + 1, true) 
                        boardCopy[r][c] = "" 
                        minEval = Min(minEval, eval) 
                    End If 
            End For 
            Return minEval 
        End If 
    End Function 
 
